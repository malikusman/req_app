# Local Docker Compose env (gitignored).
# Copy: cp .env.example .env
# Then set OPENAI_API_KEY and recreate rails/sidekiq/langgraph:
#   docker compose up -d --force-recreate rails sidekiq langgraph

# Required for live discovery questions, document summaries, and pgvector embeddings/RAG
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Meta WhatsApp (leave blank to use whatsapp:simulate)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=req_app_verify_token
META_WHATSAPP_DISPLAY_NUMBER=

# Catalog market sync (Sidekiq cron; default every 12 hours)
AI_CATALOG_SYNC_INTERVAL_HOURS=12
AI_CATALOG_MAX_CANDIDATES_PER_RUN=25
AI_MARKET_ALERT_MAX_PER_MONTH=2
AI_MARKET_ALERT_MIN_SCORE=0.8
AI_MARKET_NEWS_MAX_AGE_DAYS=14

# Stripe billing (leave blank locally to use mock checkout when ALLOW_MOCKS=1)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
