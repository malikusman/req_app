# Local Docker Compose env (gitignored).
# Copy: cp .env.example .env
# Recreate after LLM changes: docker compose up -d --force-recreate rails sidekiq langgraph
#
# Switch providers by using ONE of the profiles below (comment the other).
# Details + cost: docs/LLM_PROVIDERS.md

# =============================================================================
# PROFILE A — Production-like OpenAI (recommended)
# Fast workhorse: gpt-4.1-mini | Reasoning (docs Analyze): o4-mini
# =============================================================================
OPENAI_API_KEY=
# OPENAI_BASE_URL=   # leave unset → https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
DOCS_MODEL_FAST=gpt-4.1-mini
DOCS_MODEL_REASONING=o4-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
OPENAI_JSON_MODE=true

# =============================================================================
# PROFILE B — Local LM Studio (Gemma chat + EmbeddingGemma)
# Uncomment and comment PROFILE A keys above. Load both models in LM Studio,
# start the local server on port 1234, then recreate containers.
# Model IDs must match LM Studio exactly (check GET /v1/models).
# =============================================================================
# OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# OPENAI_API_KEY=lm-studio
# OPENAI_MODEL=google/gemma-4-12b-qat
# DOCS_MODEL_FAST=google/gemma-4-12b-qat
# DOCS_MODEL_REASONING=google/gemma-4-12b-qat
# EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
# EMBEDDING_MODEL=text-embedding-embeddinggemma-300m-qat
# EMBEDDING_DIMENSIONS=768
# OPENAI_JSON_MODE=false
# OPENAI_MAX_TOKENS=2500
# LANGGRAPH_DOCS_READ_TIMEOUT=900

# Optional Meta WhatsApp (leave blank to use whatsapp:simulate)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=req_app_verify_token
META_WHATSAPP_DISPLAY_NUMBER=

# Catalog market sync (Sidekiq cron; default every 12 hours)
AI_CATALOG_SYNC_INTERVAL_HOURS=12
AI_CATALOG_MAX_CANDIDATES_PER_RUN=25
AI_MARKET_ALERT_MAX_PER_MONTH=2
AI_MARKET_ALERT_MIN_SCORE=0.8
AI_MARKET_NEWS_MAX_AGE_DAYS=14

# Stripe billing (leave blank locally to use mock checkout when ALLOW_MOCKS=1)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Internal Rails↔agent token (required in production)
INTERNAL_API_TOKEN=

# Optional override for Rails.cache (defaults to REDIS_URL with DB /1 — HIGH-2)
# REDIS_CACHE_URL=redis://redis:6379/1

# Shared Redis for Sidekiq + OpenAI circuit breaker (Rails + langgraph agent).
# Both must use the same REDIS_URL DB /0 for openai:circuit_open (FEAT-AGENTS).
# REDIS_URL=redis://redis:6379/0

# Optional LangGraph HTTP read timeout seconds (default 45 — FEAT-AGENTS)
# LANGGRAPH_READ_TIMEOUT=45

# LangSmith tracing for the discovery agent (BLK-4 easy-wins). Auto-enables when key is set.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=worktruth-agent
# LANGSMITH_TRACING=false
