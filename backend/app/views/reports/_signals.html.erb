<% company_name = snapshot.dig("company", "name") %>
<% ranked = Array(signals).sort_by { |s| -(s["strength"].to_f) } %>
<% docs_first = snapshot["docs_first_phase"] == true || snapshot["report_kind"].to_s == "baseline" %>
<% evidence_sources = docs_first ? "internal documents" : "documents, interviews, and media" %>
<section class="page">
  <div class="eyebrow">Signals</div>
  <h1 style="font-size:26pt;margin:4mm 0 3mm;"><%= h report_action_title(snapshot, :signals, "Recurring pain points") %></h1>
  <div class="exhibit">
    <div class="exlabel">Exhibit 3 · Signals ranked by strength</div>
    <h3>Colour encodes category: process, tooling, people, data.</h3>
    <% ranked.each do |signal| %>
      <% cat = report_category_class(signal["signal_type"]) %>
      <% pct = report_pct(signal["strength"]) %>
      <div class="lolli">
        <span class="lab"><%= h signal["label"] %></span>
        <span class="track">
          <span class="line <%= cat %>" style="width:<%= pct %>%"></span>
          <span class="dot <%= cat %>" style="left:<%= pct %>%"></span>
        </span>
        <span class="val" title="<%= format("%.2f", signal["strength"].to_f) %>"><%= report_strength_label(signal["strength"]) %></span>
      </div>
    <% end %>
    <div class="caption"><%= h report_source_caption(company_name, version: report_version) %></div>
    <div class="mark">Worktruth</div>
  </div>
  <div class="card-grid-3">
    <% ranked.each do |signal| %>
      <% cat = report_category_class(signal["signal_type"]) %>
      <% pct = report_pct(signal["strength"]) %>
      <% depts = Array(signal["departments"]).reject(&:blank?) %>
      <% excerpts = report_signal_excerpts(signal, limit: 3) %>
      <% multimodal = report_multimodal_labels(signal) %>
      <div class="signal-card <%= cat %>">
        <div class="meta"><%= h report_category_label(cat) %><% if depts.any? %> · <%= h depts.join(", ") %><% end %></div>
        <div class="st"><%= h signal["label"] %></div>
        <div class="strength"><i style="width:<%= pct %>%"></i></div>
        <div class="meta"><%= report_strength_label(signal["strength"]) %> strength</div>
        <% ev = signal["evidence_count"].to_i %>
        <% if excerpts.any? %>
          <p>Seen in <%= ev.positive? ? ev : excerpts.size %> evidence point<%= "s" unless (ev.positive? ? ev : excerpts.size) == 1 %> across <%= evidence_sources %>.</p>
        <% elsif ev.positive? %>
          <p><%= ev %> supporting reference<%= "s" unless ev == 1 %> on record.</p>
        <% end %>
        <% if multimodal.any? %>
          <div class="meta" style="margin-top:2mm;">Also seen in: <%= h multimodal.join(", ") %></div>
        <% end %>
        <% excerpts.each do |excerpt| %>
          <div class="evidence"><%= h excerpt.truncate(160) %></div>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
