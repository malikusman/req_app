<% if signals.empty? %>
  <p class="meta"><em>No signals detected yet.</em></p>
<% else %>
  <table>
    <thead>
      <tr><th>Signal</th><th>Strength</th><th>Departments</th><th>Evidence</th></tr>
    </thead>
    <tbody>
      <% signals.each do |signal| %>
        <% pct = (signal['strength'].to_f * 100).round %>
        <% media = Array(signal['multimodal_evidence']) %>
        <% evidence = "#{signal['evidence_count'].to_i} mentions" %>
        <% evidence += "; #{media.size} media item#{'s' unless media.size == 1}" if media.any? %>
        <tr>
          <td>
            <%= h signal['label'] %>
            <div class="bar" style="margin-top: 6px;"><div class="bar-fill" style="width: <%= pct %>%"></div></div>
          </td>
          <td><%= pct %>%</td>
          <td><%= h Array(signal['departments']).join(', ') %></td>
          <td><%= h evidence %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
