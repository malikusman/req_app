<%# A consultant "edit" override — the expert's text REPLACES the AI-generated
    section entirely (not a note beside it). Rendered as a normal report page. %>
<% company_name = snapshot.dig("company", "name") %>
<section class="page">
  <div class="eyebrow">Revised by <%= edit["consultant"].present? ? h(edit["consultant"]) : "the expert consultant" %><% if edit["consultant"].present? %> · independent expert consultant<% end %></div>
  <h1 style="font-size:28pt;margin:4mm 0 3mm;"><%= h(edit["title"].presence || section_label(key)) %></h1>
  <div class="lead" style="max-width:200mm;white-space:pre-wrap;"><%= h edit["body"] %></div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
