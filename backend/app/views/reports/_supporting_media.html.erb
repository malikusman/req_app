<% company_name = snapshot.dig("company", "name") %>
<section class="page">
  <div class="eyebrow">Supporting media</div>
  <h1 style="font-size:28pt;margin:4mm 0 4mm;">Evidence base</h1>
  <div class="card-grid-3">
    <% Array(supporting_media).each do |media| %>
      <div class="media-card">
        <div class="c"><%= h media["attachment_type"].to_s.tr("_", " ") %></div>
        <div class="k"><%= h(media["caption"].presence || "#{media["attachment_type"].to_s.humanize} evidence") %></div>
        <% if media["summary"].present? %>
          <p><%= h media["summary"].to_s.truncate(220) %></p>
        <% end %>
        <% if media["employee_department"].present? %>
          <div class="c" style="margin-top:2mm;"><%= h media["employee_department"] %></div>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
