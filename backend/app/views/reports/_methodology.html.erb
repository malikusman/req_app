<% company_name = snapshot.dig("company", "name") %>
<% participation = snapshot["participation"] || {} %>
<% docs_first = snapshot["docs_first_phase"] == true || snapshot["report_kind"].to_s == "baseline" %>
<% doc_count = Array(snapshot["supporting_documents"]).size %>
<section class="page">
  <div class="eyebrow">08 — Methodology</div>
  <h1 style="font-size:28pt;margin:4mm 0 4mm;">How we measured</h1>
  <div class="split">
    <div>
      <% if docs_first %>
        <p class="method" style="margin-top:0;">
          This baseline report draws on structured extraction from internal documents for <%= h company_name %>
          <% if doc_count.positive? %>
            (<%= doc_count %> supporting <%= doc_count == 1 ? "document" : "documents" %> cited)
          <% end %>.
          Signals and patterns are produced by rule-based extraction over document text (and specialist interview agents when conversations are added later). Recommendations are synthesized from those signals against the solution catalog — not free-form generative research.
        </p>
      <% else %>
        <p class="method" style="margin-top:0;">
          Findings draw on adaptive discovery interviews (WhatsApp and web chat) for <%= h company_name %>, conducted by specialist interview agents when enabled.
          <% if participation["invited"].to_i.positive? %>
            <%= participation["completed"].to_i %> of <%= participation["invited"].to_i %> invited employees completed the full discovery flow.
          <% end %>
          <% if doc_count.positive? %>
            Interview evidence is reinforced by <%= doc_count %> internal <%= doc_count == 1 ? "document" : "documents" %>.
          <% end %>
          Post-interview signals and patterns use structured extraction over conversation and document evidence; recommendations are catalog-matched recipes reviewed before client delivery.
        </p>
      <% end %>
    </div>
    <div class="method" style="align-self:center;">
      <dl>
        <dt>Readiness weighting</dt>
        <% if docs_first %>
          <dd style="font-size:9pt;color:var(--muted);">Ready documents (40%), document departments (20%), pattern confidence (25%), multimodal / document sources (15%).</dd>
        <% else %>
          <dd style="font-size:9pt;color:var(--muted);">Blended score: document baseline plus employee coverage, department spread, pattern confidence, and multimodal evidence as interviews accumulate.</dd>
        <% end %>
        <dt>Review</dt>
        <dd style="font-size:9pt;color:var(--muted);">When reviewers are assigned, overall notes and section comments are merged into an appendix at platform approval. Live discussions and WhatsApp follow-up threads are collaboration tooling and are intentionally excluded from this deliverable.</dd>
      </dl>
    </div>
  </div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
