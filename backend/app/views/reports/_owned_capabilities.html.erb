<% company_name = snapshot.dig("company", "name") %>
<% owned = Array(snapshot["owned_solutions"]) %>
<% if owned.any? %>
<section class="page">
  <div class="eyebrow">Existing capabilities</div>
  <h1 style="font-size:28pt;margin:4mm 0 3mm;">What you already own</h1>
  <p class="lead" style="max-width:200mm;">In-house and already-owned solutions this organization brought to the engagement — and how well each addresses the frictions identified above. Prefer extending these before adding new tools.</p>
  <div class="card-grid-3" style="margin-top:5mm;">
    <% owned.each do |sol| %>
      <div class="rec-card">
        <div class="match cat-tooling"><%= h sol["name"] %></div>
        <div class="meta">
          <%= report_score_band(sol["fit_confidence"]) %> fit <span class="muted">(<%= report_pct(sol["fit_confidence"]) %>%)</span>
          <% if sol["reviewer_endorsed"] %> · <span style="color:var(--teal);font-weight:600;">Reviewer-endorsed</span><% end %>
        </div>
        <% if sol["description"].present? %><p><%= h sol["description"] %></p><% end %>
        <% if Array(sol["addresses_signals"]).any? %>
          <div class="meta" style="margin-top:2mm;">Addresses: <%= h Array(sol["addresses_signals"]).join(", ") %></div>
        <% elsif Array(sol["addresses_patterns"]).any? %>
          <div class="meta" style="margin-top:2mm;">Relates to: <%= h Array(sol["addresses_patterns"]).join(", ") %></div>
        <% else %>
          <div class="meta" style="margin-top:2mm;">No direct match to the frictions found — capacity for other needs.</div>
        <% end %>
        <% if sol["reviewer_note"].present? %>
          <p class="muted" style="margin-top:2mm;">Reviewer<%= sol["reviewer_name"].present? ? " (#{sol['reviewer_name']})" : "" %>: <%= h sol["reviewer_note"] %></p>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="caption" style="margin-top:4mm;"><%= h report_source_caption(company_name, version: report_version) %></div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
<% end %>
