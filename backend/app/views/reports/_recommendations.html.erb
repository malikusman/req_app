<% company_name = snapshot.dig("company", "name") %>
<section class="page">
  <div class="eyebrow">07 — Recommendations</div>
  <h1 style="font-size:28pt;margin:4mm 0 4mm;">Suggested actions</h1>
  <div class="card-grid-3">
    <% Array(recommendations).each do |rec| %>
      <% pill = report_priority_pill(rec["priority"]) %>
      <% match = report_catalog_match(rec) %>
      <div class="rec-card">
        <span class="pill <%= pill %>"><%= h report_priority_label(rec["priority"]) %></span>
        <h4><%= h rec["title"] %></h4>
        <p><%= h rec["description"] %></p>
        <% if match.present? %>
          <div class="match">Catalog match: <%= h match %></div>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>

<% if Array(recommendations).any? %>
<section class="page">
  <div class="eyebrow">07 — Prioritization<% if report_has_delta?(snapshot["delta_from_previous"]) %> · 04 — What changed<% end %></div>
  <h1 style="font-size:26pt;margin:4mm 0 4mm;">Where to start<% if report_has_delta?(snapshot["delta_from_previous"]) %>, and what moved<% end %></h1>
  <div class="split">
    <div class="exhibit">
      <div class="exlabel">Exhibit 4 · Impact vs feasibility</div>
      <h3>Prioritize high-impact, high-feasibility moves first.</h3>
      <%= report_priority_matrix_svg(recommendations) %>
      <div class="caption"><%= h report_source_caption(company_name, version: report_version) %></div>
      <div class="mark">Req</div>
    </div>
    <% if report_has_delta?(snapshot["delta_from_previous"]) %>
      <% delta = snapshot["delta_from_previous"] || {} %>
      <div>
        <div class="eyebrow">04 — Delta</div>
        <div class="delta" style="margin-top:4mm;">
          <div class="col add">
            <h4>New</h4>
            <ul>
              <% Array(delta["new_signals"]).each do |s| %><li>Signal: <%= h s["label"] %></li><% end %>
              <% Array(delta["new_patterns"]).each do |p| %><li>Pattern: <%= h p["title"] %></li><% end %>
              <% Array(delta["new_recommendations"]).each do |r| %><li>Recommendation: <%= h r["title"] %></li><% end %>
              <% if Array(delta["new_signals"]).empty? && Array(delta["new_patterns"]).empty? && Array(delta["new_recommendations"]).empty? %>
                <li>No new items this version</li>
              <% end %>
            </ul>
          </div>
          <div class="col chg">
            <h4>Changed</h4>
            <ul>
              <% Array(delta["strengthened_signals"]).each do |s| %>
                <li><%= h s["label"] %> → <%= format("%.2f", s["strength"].to_f) %></li>
              <% end %>
              <% if Array(delta["strengthened_signals"]).empty? %>
                <li>No strengthened signals</li>
              <% end %>
            </ul>
          </div>
          <div class="col rem">
            <h4>Summary</h4>
            <ul><li><%= h delta["summary"] %></li></ul>
          </div>
        </div>
      </div>
    <% else %>
      <div>
        <p class="lead">This is the first discovery report for <%= h company_name %>. Subsequent versions will show what is new, strengthened, or resolved.</p>
      </div>
    <% end %>
  </div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
<% end %>
