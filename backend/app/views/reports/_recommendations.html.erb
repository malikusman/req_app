<% company_name = snapshot.dig("company", "name") %>
<section class="page">
  <div class="eyebrow">Recommendations</div>
  <h1 style="font-size:26pt;margin:4mm 0 3mm;"><%= h report_action_title(snapshot, :recommendations, "What to do") %></h1>
  <p class="lead" style="max-width:200mm;margin-bottom:5mm;">Prioritized actions drawn from the findings above. Each names a matched tool where one fits — the full product view follows in Capabilities.</p>
  <div class="card-grid-3">
    <% Array(recommendations).each do |rec| %>
      <% pill = report_priority_pill(rec["priority"]) %>
      <% matches = report_catalog_matches(rec) %>
      <div class="rec-card">
        <span class="pill <%= pill %>"><%= h report_priority_label(rec["priority"]) %></span>
        <h4><%= h rec["title"] %></h4>
        <p><%= h rec["description"] %></p>
        <% if rec["implementation_outline"].present? %>
          <p style="margin-top:2mm;font-size:8.5pt;"><strong>How:</strong> <%= h rec["implementation_outline"].to_s.truncate(220) %></p>
        <% end %>
        <% matches.first(3).each do |match| %>
          <div class="match">
            <%= h match["name"] %>
            <% if match["score"].present? %> · <%= h report_fit_score_label(match["score"]) %><% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>

<% if Array(recommendations).any? %>
<section class="page">
  <div class="eyebrow">Prioritization<% if report_has_delta?(snapshot["delta_from_previous"]) %> · What changed<% end %></div>
  <h1 style="font-size:26pt;margin:4mm 0 4mm;">Where to start<% if report_has_delta?(snapshot["delta_from_previous"]) %>, and what moved<% end %></h1>
  <div class="split">
    <% matrix_svg = report_priority_matrix_svg(recommendations) %>
    <% if matrix_svg.present? %>
    <div class="exhibit">
      <div class="exlabel">Exhibit 4 · Impact vs feasibility</div>
      <h3>Prioritize high-impact, high-feasibility moves first.</h3>
      <%= matrix_svg %>
      <div class="caption">Impact reflects evidence weight; feasibility reflects implementation effort and existing systems. <%= h report_source_caption(company_name, version: report_version) %></div>
      <div class="mark">Worktruth</div>
    </div>
    <% else %>
    <div class="exhibit">
      <div class="exlabel">Exhibit 4 · Where to start</div>
      <h3>Recommendations, ordered by priority.</h3>
      <ol class="plain" style="padding-left:5mm;">
        <% Array(recommendations).sort_by { |r| { "high" => 0, "medium" => 1, "med" => 1 }.fetch(r["priority"].to_s.downcase, 2) }.first(6).each do |r| %>
          <li style="margin-bottom:2mm;"><strong><%= h r["title"] %></strong> <span class="muted">(<%= h report_priority_label(r["priority"]) %>)</span></li>
        <% end %>
      </ol>
      <div class="caption"><%= h report_source_caption(company_name, version: report_version) %></div>
      <div class="mark">Worktruth</div>
    </div>
    <% end %>
    <% if report_has_delta?(snapshot["delta_from_previous"]) %>
      <% delta = snapshot["delta_from_previous"] || {} %>
      <div>
        <div class="eyebrow">Delta</div>
        <div class="delta" style="margin-top:4mm;">
          <div class="col add">
            <h4>New</h4>
            <ul>
              <% Array(delta["new_signals"]).each do |s| %><li>Signal: <%= h s["label"] %></li><% end %>
              <% Array(delta["new_patterns"]).each do |p| %><li>Pattern: <%= h p["title"] %></li><% end %>
              <% Array(delta["new_recommendations"]).each do |r| %><li>Recommendation: <%= h r["title"] %></li><% end %>
              <% if Array(delta["new_signals"]).empty? && Array(delta["new_patterns"]).empty? && Array(delta["new_recommendations"]).empty? %>
                <li>No new items this version</li>
              <% end %>
            </ul>
          </div>
          <div class="col chg">
            <h4>Changed</h4>
            <ul>
              <% Array(delta["strengthened_signals"]).each do |s| %>
                <li><%= h s["label"] %> → <%= format("%.2f", s["strength"].to_f) %></li>
              <% end %>
              <% if Array(delta["strengthened_signals"]).empty? %>
                <li>No strengthened signals</li>
              <% end %>
            </ul>
          </div>
          <div class="col rem">
            <h4>Summary</h4>
            <ul><li><%= h delta["summary"] %></li></ul>
          </div>
        </div>
      </div>
    <% else %>
      <div>
        <p class="lead">Start with the highest-priority actions that already have catalog matches and documented evidence. This is the first discovery report for <%= h company_name %>; subsequent versions will show what is new, strengthened, or resolved.</p>
        <ul style="margin-top:4mm;padding-left:4mm;font-size:9pt;">
          <% Array(recommendations).sort_by { |r| report_priority_pill(r["priority"]) == "high" ? 0 : 1 }.first(4).each do |rec| %>
            <li style="margin-bottom:2mm;"><strong><%= h rec["title"] %></strong> — <%= h report_priority_label(rec["priority"]) %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
<% end %>
