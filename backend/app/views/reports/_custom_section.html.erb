<% company_name = snapshot.dig("company", "name") %>
<section class="page">
  <div class="eyebrow">Reviewer addition</div>
  <h1 style="font-size:28pt;margin:4mm 0 3mm;"><%= h section["title"] %></h1>
  <% if section["reviewer"].present? %>
    <div class="meta" style="margin-bottom:4mm;">Added by <%= h section["reviewer"] %>, independent expert reviewer</div>
  <% end %>
  <div class="lead" style="max-width:200mm;white-space:pre-wrap;"><%= h section["body"] %></div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
