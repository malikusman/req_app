<% company_name = snapshot.dig("company", "name") %>
<% participation = snapshot["participation"] || {} %>
<% invited = participation["invited"].to_i %>
<% started = participation["started"].to_i %>
<% completed = participation["completed"].to_i %>
<% rate = participation["completion_rate"] %>
<% rate_pct = rate.nil? ? (invited.positive? ? ((completed.to_f / invited) * 100).round : 0) : report_pct(rate) %>
<% coverage = Array(snapshot["department_coverage"]) %>
<section class="page" id="participation">
  <div class="eyebrow">03 — Participation</div>
  <h1 style="font-size:28pt;margin:4mm 0 3mm;">Who took part</h1>
  <div class="split">
    <div>
      <p class="lead">
        <%= completed %> of <%= invited %> invited employees completed the discovery interview<%= invited.positive? ? ", a #{rate_pct}% completion rate" : "" %>.
      </p>
      <% if invited.positive? && completed.zero? %>
        <p>Employees have been invited; intelligence and readiness will strengthen as interviews complete. Document-based findings remain the current baseline.</p>
      <% else %>
        <p>Participation underpins readiness. Broader department coverage and completed interviews produce a clearer, more actionable picture of how work really happens.</p>
      <% end %>
      <% if coverage.any? %>
        <h3 style="margin-top:4mm;">Coverage by department</h3>
        <table class="simple" style="width:100%;border-collapse:collapse;font-size:10pt;">
          <thead>
            <tr>
              <th style="text-align:left;padding:1.5mm;border-bottom:1px solid #ccc;">Department</th>
              <th style="text-align:right;padding:1.5mm;border-bottom:1px solid #ccc;">Completed</th>
              <th style="text-align:right;padding:1.5mm;border-bottom:1px solid #ccc;">Target</th>
            </tr>
          </thead>
          <tbody>
            <% coverage.first(12).each do |row| %>
              <tr>
                <td style="padding:1.5mm;border-bottom:1px solid #eee;"><%= h row["department"].presence || "Unspecified" %></td>
                <td style="text-align:right;padding:1.5mm;border-bottom:1px solid #eee;"><%= row["completed"].to_i %></td>
                <td style="text-align:right;padding:1.5mm;border-bottom:1px solid #eee;"><%= row["target"].to_i %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
    <div class="exhibit">
      <div class="exlabel">Exhibit 2 · Interview participation</div>
      <h3>Completion by stage.</h3>
      <div class="funnel">
        <div class="step"><div class="v"><%= invited %></div><div class="l">Invited</div></div>
        <div class="step"><div class="v"><%= started %></div><div class="l">Started</div></div>
        <div class="step"><div class="v"><%= completed %></div><div class="l">Completed</div></div>
        <div class="step"><div class="v"><%= rate_pct %>%</div><div class="l">Completion</div></div>
      </div>
      <div class="caption"><%= h report_source_caption(company_name, version: report_version) %></div>
      <div class="mark">Worktruth</div>
    </div>
  </div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
