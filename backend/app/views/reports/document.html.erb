<!DOCTYPE html>
<html lang="<%= snapshot.dig('company', 'locale') || 'en' %>">
<head>
  <meta charset="utf-8"/>
  <title>Worktruth <%= report_kind_noun(snapshot) %> Report — <%= h snapshot.dig('company', 'name') %></title>
  <%= render "reports/styles" %>
</head>
<body>
<% report_reset_page! %>
<% @_report_snapshot = snapshot %>
<% company_name = snapshot.dig("company", "name") %>
<% signals = Array(snapshot["signals"]) %>
<% patterns = Array(snapshot["patterns"]) %>
<% recommendations = Array(snapshot["recommendations"]) %>
<% supporting_media = Array(snapshot["supporting_media"]) %>
<% delta = snapshot["delta_from_previous"] || {} %>
<% toc_entries = report_toc_entries(snapshot) %>

<%= render "reports/cover", snapshot: snapshot, generated_label: generated_label, report_version: report_version %>
<%= render "reports/contents", snapshot: snapshot, toc_entries: toc_entries %>

<%# Helper: render a reviewer edit-note (if any) before a section, and any custom
    sections a reviewer anchored after it. %>
<% edit_note = ->(key) { (ed = report_section_edit(snapshot, key)) ? render("reports/section_edit_note", edit: ed) : nil } %>
<% custom_after = ->(key) { report_custom_sections(snapshot, after: key).map { |cs| render("reports/custom_section", snapshot: snapshot, section: cs) }.join.html_safe } %>

<% unless report_section_hidden?(snapshot, "executive_summary") %>
  <% if snapshot["executive_summary"].present? %>
    <%= edit_note.call("executive_summary") %>
    <%= render "reports/executive_summary", snapshot: snapshot, report_version: report_version %>
  <% end %>
<% end %>
<%= custom_after.call("executive_summary") %>

<% unless report_section_hidden?(snapshot, "readiness") %>
  <% if snapshot.dig("readiness", "score").present? %>
    <%= edit_note.call("readiness") %>
    <%= render "reports/readiness", snapshot: snapshot, report_version: report_version %>
  <% end %>
<% end %>
<%= custom_after.call("readiness") %>

<% unless report_section_hidden?(snapshot, "company_context") %>
  <%= edit_note.call("company_context") %>
  <%= render "reports/company_context", snapshot: snapshot, report_version: report_version %>
<% end %>
<%= custom_after.call("company_context") %>

<% participation = snapshot["participation"] || {} %>
<% unless report_section_hidden?(snapshot, "participation") %>
  <% if participation["invited"].to_i.positive? || participation["completed"].to_i.positive? %>
    <%= edit_note.call("participation") %>
    <%= render "reports/participation", snapshot: snapshot, report_version: report_version %>
  <% end %>
<% end %>
<%= custom_after.call("participation") %>

<% if report_has_delta?(delta) && recommendations.empty? && !report_section_hidden?(snapshot, "delta") %>
  <%= render "reports/delta", snapshot: snapshot, report_version: report_version %>
<% end %>

<% docs_first = snapshot["docs_first_phase"] == true || snapshot["report_kind"].to_s == "baseline" %>
<% if signals.any? && !report_section_hidden?(snapshot, "signals") %>
  <%= edit_note.call("signals") %>
  <%= render "reports/divider",
        accent_label: "Signals & Patterns",
        accent_bg: "var(--magenta)",
        eyebrow: "05 & 06 — Signals and patterns",
        title: docs_first ? "What the documents revealed" : "What the interviews revealed",
        lead: docs_first ?
          "Signals are recurring friction themes drawn from internal documents. Patterns connect those themes across departments and file types." :
          "Signals are recurring pain points drawn directly from employee interviews. Patterns are the themes that connect them across departments.",
        highlights: [
          docs_first ?
            "<strong>#{signals.size}</strong> signal#{'s' unless signals.size == 1} surfaced from document analysis.".html_safe :
            "<strong>#{signals.size}</strong> signal#{'s' unless signals.size == 1} surfaced from discovery interviews.".html_safe,
          "<strong>#{patterns.size}</strong> cross-team pattern#{'s' unless patterns.size == 1} identified.".html_safe
        ] %>
  <%= render "reports/signals", snapshot: snapshot, signals: signals, report_version: report_version %>
  <% top = signals.max_by { |s| s["strength"].to_f } %>
  <% excerpt = top && report_signal_excerpt(top) %>
  <% quote = excerpt.presence || "The strongest recurring theme is #{top&.dig('label') || 'operational friction'} across teams." %>
  <%= render "reports/pull_quote", snapshot: snapshot, quote: quote, accent_phrase: top&.dig("label") %>
<% end %>
<%= custom_after.call("signals") %>

<% if patterns.any? && !report_section_hidden?(snapshot, "patterns") %>
  <%= edit_note.call("patterns") %>
  <%= render "reports/patterns", snapshot: snapshot, patterns: patterns, report_version: report_version %>
<% end %>
<%= custom_after.call("patterns") %>

<% if recommendations.any? && !report_section_hidden?(snapshot, "recommendations") %>
  <%= edit_note.call("recommendations") %>
  <%= render "reports/recommendations", snapshot: snapshot, recommendations: recommendations, report_version: report_version %>
<% end %>
<%= custom_after.call("recommendations") %>

<% if snapshot.dig("narrative", "roadmap").present? && !report_section_hidden?(snapshot, "roadmap") %>
  <%= edit_note.call("roadmap") %>
  <%= render "reports/roadmap", snapshot: snapshot, report_version: report_version %>
<% end %>
<%= custom_after.call("roadmap") %>

<% if Array(snapshot["agentic_ideas"]).any? && !report_section_hidden?(snapshot, "opportunities") %>
  <%= render "reports/opportunities", snapshot: snapshot, report_version: report_version %>
<% end %>
<%= custom_after.call("opportunities") %>

<% if Array(snapshot["owned_solutions"]).any? && !report_section_hidden?(snapshot, "owned_capabilities") %>
  <%= edit_note.call("owned_capabilities") %>
  <%= render "reports/owned_capabilities", snapshot: snapshot, report_version: report_version %>
<% end %>
<%= custom_after.call("owned_capabilities") %>

<% if (Array(snapshot.dig("tools_catalog", "curated_matches")).any? || Array(snapshot.dig("tools_catalog", "endorsements")).any? || Array(snapshot["supporting_documents"]).any?) && !report_section_hidden?(snapshot, "tools_catalog") %>
  <%= edit_note.call("tools_catalog") %>
  <%= render "reports/tools_catalog", snapshot: snapshot, report_version: report_version %>
<% end %>
<%= custom_after.call("tools_catalog") %>

<% if supporting_media.any? && !report_section_hidden?(snapshot, "supporting_media") %>
  <%= render "reports/supporting_media", snapshot: snapshot, supporting_media: supporting_media, report_version: report_version %>
<% end %>
<%= custom_after.call("supporting_media") %>

<% unless report_section_hidden?(snapshot, "methodology") %>
  <%= render "reports/methodology", snapshot: snapshot, report_version: report_version %>
<% end %>
<%= custom_after.call("methodology") %>

<% review_overlay = local_assigns.fetch(:review_overlay, nil) %>
<% structured_findings = local_assigns.fetch(:structured_findings) { Array(review_overlay&.dig("structured_findings")) } %>
<% section_dispositions = local_assigns.fetch(:section_dispositions) { Array(review_overlay&.dig("section_dispositions")) } %>
<% if review_notes.present? || structured_findings.any? || section_dispositions.any? %>
  <%= render "reports/review_appendix",
        snapshot: snapshot,
        review_notes: review_notes,
        review_overlay: review_overlay,
        structured_findings: structured_findings,
        section_dispositions: section_dispositions,
        report_version: report_version %>
<% end %>
</body>
</html>
