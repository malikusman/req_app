<!DOCTYPE html>
<html lang="<%= snapshot.dig('company', 'locale') || 'en' %>">
<head>
  <meta charset="utf-8"/>
  <title>Mjadi <%= report_kind_noun(snapshot) %> Report — <%= h snapshot.dig('company', 'name') %></title>
  <%= render "reports/styles" %>
</head>
<body>
<% report_reset_page! %>
<% @_report_snapshot = snapshot %>
<% company_name = snapshot.dig("company", "name") %>
<% signals = Array(snapshot["signals"]) %>
<% patterns = Array(snapshot["patterns"]) %>
<% recommendations = Array(snapshot["recommendations"]) %>
<% delta = snapshot["delta_from_previous"] || {} %>
<% toc_entries = report_toc_entries(snapshot) %>

<%# Section order follows the pyramid: the answer, the expert's verdict, the
    findings, the actions — then the method and the context that support them.
    Readiness (our internal go/no-go gate) and Participation (our delivery KPI)
    sit in the back matter with Methodology, where a reader who wants to audit
    the work will look for them. They used to be pages 4 and 6, ahead of the
    findings. %>

<%= render "reports/cover", snapshot: snapshot, generated_label: generated_label, report_version: report_version %>
<%= render "reports/contents", snapshot: snapshot, toc_entries: toc_entries %>

<%# Consultant overrides: an "edit" REPLACES the AI section with the expert's text
    (not a note beside it); "hide" drops it; "add" injects a custom section after
    its anchor. ai_or_edit picks the expert's body when present, else the AI render. %>
<% custom_after = ->(key) { report_custom_sections(snapshot, after: key).map { |cs| render("reports/consultant_section", snapshot: snapshot, section: cs, kind: "added") }.join.html_safe } %>
<% section_edited = ->(key) { (ed = report_section_edit(snapshot, key)) && ed["body"].to_s.strip.present? } %>
<% ai_or_edit = ->(key, present, ai) {
     if section_edited.call(key)
       render("reports/consultant_section", snapshot: snapshot,
              section: report_section_edit(snapshot, key).merge("section_key" => key), kind: "revised")
     elsif present
       ai.call
     else
       "".html_safe
     end
   } %>

<% unless report_section_hidden?(snapshot, "executive_summary") %>
  <%= ai_or_edit.call("executive_summary", snapshot["executive_summary"].present?, -> { render "reports/executive_summary", snapshot: snapshot, report_version: report_version }) %>
<% end %>
<%= custom_after.call("executive_summary") %>

<%# The expert's own answer and the value they put on it — immediately after the
    summary, because it is the most credible page in the document. %>
<% unless report_section_hidden?(snapshot, "expert_verdict") %>
  <%= render "reports/expert_verdict", snapshot: snapshot, report_version: report_version %>
<% end %>
<%= custom_after.call("expert_verdict") %>

<% unless report_section_hidden?(snapshot, "company_context") %>
  <%= ai_or_edit.call("company_context", true, -> { render "reports/company_context", snapshot: snapshot, report_version: report_version }) %>
<% end %>
<%= custom_after.call("company_context") %>

<% if report_has_delta?(delta) && recommendations.empty? && !report_section_hidden?(snapshot, "delta") %>
  <%= render "reports/delta", snapshot: snapshot, report_version: report_version %>
<% end %>
<%= custom_after.call("delta") %>

<% docs_first = snapshot["docs_first_phase"] == true || snapshot["report_kind"].to_s == "baseline" %>
<% if signals.any? && !report_section_hidden?(snapshot, "signals") %>
  <%= render "reports/divider",
        accent_label: "Signals & Patterns",
        accent_bg: "var(--magenta)",
        eyebrow: "Signals & patterns",
        title: docs_first ? "What the documents revealed" : "What the interviews revealed",
        lead: docs_first ?
          "Signals are recurring friction themes drawn from internal documents. Patterns connect those themes across departments and file types." :
          "Signals are recurring pain points drawn from employee interviews. Patterns are the themes that connect them across departments. Findings are reported with the weight of evidence behind them; the source material stays in the working papers.",
        highlights: [
          docs_first ?
            "<strong>#{signals.size}</strong> signal#{'s' unless signals.size == 1} surfaced from document analysis.".html_safe :
            "<strong>#{signals.size}</strong> signal#{'s' unless signals.size == 1} surfaced from discovery interviews.".html_safe,
          "<strong>#{patterns.size}</strong> cross-team pattern#{'s' unless patterns.size == 1} identified.".html_safe
        ] %>
  <% if section_edited.call("signals") %>
    <%= render "reports/consultant_section", snapshot: snapshot,
          section: report_section_edit(snapshot, "signals").merge("section_key" => "signals"), kind: "revised" %>
  <% else %>
    <%= render "reports/signals", snapshot: snapshot, signals: signals, report_version: report_version %>
  <% end %>
<% end %>
<%= custom_after.call("signals") %>

<% if patterns.any? && !report_section_hidden?(snapshot, "patterns") %>
  <%= ai_or_edit.call("patterns", true, -> { render "reports/patterns", snapshot: snapshot, patterns: patterns, report_version: report_version }) %>
<% end %>
<%= custom_after.call("patterns") %>

<% if recommendations.any? && !report_section_hidden?(snapshot, "recommendations") %>
  <%= ai_or_edit.call("recommendations", true, -> { render "reports/recommendations", snapshot: snapshot, recommendations: recommendations, report_version: report_version }) %>
<% end %>
<%= custom_after.call("recommendations") %>

<% if snapshot["roadmap"].present? && !report_section_hidden?(snapshot, "roadmap") %>
  <%= ai_or_edit.call("roadmap", true, -> { render "reports/roadmap", snapshot: snapshot, report_version: report_version }) %>
<% end %>
<%= custom_after.call("roadmap") %>

<% if Array(snapshot["agentic_ideas"]).any? && !report_section_hidden?(snapshot, "opportunities") %>
  <%= render "reports/opportunities", snapshot: snapshot, report_version: report_version %>
<% end %>
<%= custom_after.call("opportunities") %>

<% if (Array(snapshot.dig("tools_catalog", "curated_matches")).any? || Array(snapshot.dig("tools_catalog", "endorsements")).any?) && !report_section_hidden?(snapshot, "tools_catalog") %>
  <%= ai_or_edit.call("tools_catalog", true, -> { render "reports/tools_catalog", snapshot: snapshot, report_version: report_version }) %>
<% end %>
<%= custom_after.call("tools_catalog") %>

<%# ---- Back matter: how the work was done, for a reader who wants to audit it ---- %>
<% participation = snapshot["participation"] || {} %>
<% docs_only_report = snapshot["report_kind"].to_s == "baseline" || snapshot["docs_first_phase"] == true %>
<% show_participation = participation["completed"].to_i.positive? || (participation["invited"].to_i.positive? && !docs_only_report) %>
<% back_matter = !report_section_hidden?(snapshot, "readiness") || show_participation || !report_section_hidden?(snapshot, "methodology") %>
<% if back_matter %>
  <%= render "reports/divider",
        accent_label: "How we know",
        accent_bg: "var(--teal)",
        eyebrow: "Method & coverage",
        title: "How this was measured",
        lead: "The pages that follow document coverage, weighting and method so the findings above can be audited rather than taken on trust.",
        highlights: [
          report_evidence_base_sentence(snapshot).to_s.upcase_first.presence,
          "Independent expert review is recorded in the appendix.".html_safe
        ].compact %>
<% end %>

<% unless report_section_hidden?(snapshot, "readiness") %>
  <%= ai_or_edit.call("readiness", snapshot.dig("readiness", "score").present?, -> { render "reports/readiness", snapshot: snapshot, report_version: report_version }) %>
<% end %>
<%= custom_after.call("readiness") %>

<% unless report_section_hidden?(snapshot, "participation") %>
  <%# The interview funnel only when interviews actually happened, or a hybrid
      engagement is mid-flight — never on a pure document baseline. %>
  <%= ai_or_edit.call("participation", show_participation, -> { render "reports/participation", snapshot: snapshot, report_version: report_version }) %>
<% end %>
<%= custom_after.call("participation") %>

<% unless report_section_hidden?(snapshot, "methodology") %>
  <%= render "reports/methodology", snapshot: snapshot, report_version: report_version %>
<% end %>
<%= custom_after.call("methodology") %>

<% review_overlay = local_assigns.fetch(:review_overlay, nil) %>
<% structured_findings = local_assigns.fetch(:structured_findings) { Array(review_overlay&.dig("structured_findings")) } %>
<% section_dispositions = local_assigns.fetch(:section_dispositions) { Array(review_overlay&.dig("section_dispositions")) } %>
<% if review_notes.present? || structured_findings.any? || section_dispositions.any? %>
  <%= render "reports/review_appendix",
        snapshot: snapshot,
        review_notes: review_notes,
        review_overlay: review_overlay,
        structured_findings: structured_findings,
        section_dispositions: section_dispositions,
        report_version: report_version %>
<% end %>
</body>
</html>
