<!DOCTYPE html>
<html lang="<%= snapshot.dig('company', 'locale') || 'en' %>">
<head>
  <meta charset="utf-8"/>
  <title>Workflow Discovery Report — <%= h snapshot.dig('company', 'name') %></title>
  <%= render "reports/print_styles" %>
</head>
<body>
  <section class="cover">
    <p class="meta">Confidential · Workflow discovery</p>
    <h1>Workflow Discovery Report</h1>
    <p class="subtitle"><%= h snapshot.dig('company', 'name') %> · Generated <%= generated_label %></p>
    <p class="score">Readiness score: <strong><%= snapshot.dig('readiness', 'score') %>%</strong></p>
    <% if snapshot['executive_summary'].present? %>
      <p style="margin-top: 1.5rem; max-width: 36rem;"><%= h snapshot['executive_summary'] %></p>
    <% end %>
  </section>

  <% delta = snapshot['delta_from_previous'] || {} %>
  <% if delta['summary'].present? && delta['summary'] != 'Initial discovery report' %>
    <div class="delta-box section-block">
      <strong>What's changed since the last report</strong>
      <p><%= h delta['summary'] %></p>
    </div>
  <% end %>

  <h2>Readiness breakdown</h2>
  <%= render "reports/readiness", readiness: snapshot['readiness'] || {} %>

  <h2>Participation</h2>
  <%= render "reports/participation", participation: snapshot['participation'] || {} %>

  <h2>Top pain points</h2>
  <%= render "reports/signals", signals: snapshot['signals'] || [] %>

  <h2>Cross-team patterns</h2>
  <%= render "reports/patterns", patterns: snapshot['patterns'] || [] %>

  <h2>Recommendations</h2>
  <%= render "reports/recommendations", recommendations: snapshot['recommendations'] || [] %>

  <h2>Supporting media</h2>
  <%= render "reports/supporting_media", supporting_media: snapshot['supporting_media'] || [] %>

  <% if review_notes.present? %>
    <div class="page-break"></div>
    <h2>Expert review notes</h2>
    <%= render "reports/review_appendix", review_notes: review_notes %>
  <% end %>

  <p class="meta footer">
    Confidential — prepared for authorized stakeholders. Employee responses and media are summarized;
    raw chat logs and original attachments are not included.
  </p>
</body>
</html>
