<% company_name = snapshot.dig("company", "name") %>
<%# Prefer the answer-first governing thought (carries the metric); fall back to
    the first sentence of the summary. %>
<% subtitle = snapshot.dig("narrative", "governing_thought").presence || snapshot["executive_summary"].to_s.split(/(?<=\.)\s/).first.presence %>
<section class="page bleed cover">
  <div class="art-panel"><%= render "reports/cover_art" %></div>
  <div class="meta-panel">
    <div class="logo">Worktruth<span>Workflow Discovery</span></div>
    <div>
      <span class="tag"><%= report_kind_noun(snapshot) %> Report</span>
      <h1><%= h company_name %></h1>
      <% if subtitle.present? %>
        <div class="sub"><%= h subtitle.truncate(140, separator: " ") %></div>
      <% end %>
      <div class="sub" style="font-size:11pt;margin-top:8mm;">
        <% if report_version.present? %>Version <%= report_version %> · <% end %><%= generated_label %>
      </div>
    </div>
  </div>
</section>
