<% company_name = snapshot.dig("company", "name") %>
<%# The consultant's own summary when they rewrote it, else the answer-first
    governing thought, else the first sentence of the summary. %>
<% subtitle = report_governing_message(snapshot) %>
<section class="page bleed cover">
  <div class="art-panel"><%= render "reports/cover_art" %></div>
  <div class="meta-panel">
    <div class="logo">Mjadi<span>Stage 1 · Diagnosis</span></div>
    <div>
      <span class="tag"><%= report_kind_noun(snapshot) %> Report</span>
      <h1><%= h company_name %></h1>
      <% if subtitle.present? %>
        <div class="sub"><%= h subtitle.truncate(140, separator: " ") %></div>
      <% end %>
      <div class="sub" style="font-size:11pt;margin-top:8mm;">
        <% if report_version.present? %>Version <%= report_version %> · <% end %><%= generated_label %> · Confidential
      </div>
    </div>
  </div>
</section>
