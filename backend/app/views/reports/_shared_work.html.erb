<% company_name = snapshot.dig("company", "name") %>
<% synthesis = snapshot["synthesis"] || {} %>
<% opportunities = Array(synthesis["opportunities"]) %>
<% root_causes = Array(synthesis["root_causes"]) %>
<% views = Array(synthesis["management_views"]) %>
<%# The consolidated subsection inside the findings (Doc 15 §4.5, Doc 00 C7): only
    when a consultant approved material findings of this kind, never padded.
    Causes are worded as analysis and leadership's view as reported (§8.2, §8.4). %>
<% if opportunities.any? || root_causes.any? || views.any? %>
<section class="page" id="shared-work">
  <div class="eyebrow">Findings · across roles</div>
  <h1 class="page-title">What connects the findings</h1>
  <p class="lead">Some of the work above is shared between roles, or comes from the same cause. Hours are counted once, where the work sits.</p>

  <% if root_causes.any? %>
    <h3 style="margin-top:4mm;">Underlying causes</h3>
    <ul class="plain" style="padding-left:4mm;">
      <% root_causes.each do |rc| %>
        <li><%= rc["fact_status"] == "CONSULTANT_CONFIRMED" ? "" : "Our analysis indicates: " %><%= h rc["statement"] %><% if Array(rc["departments"]).any? %> <span class="muted">(<%= h Array(rc["departments"]).map { |d| report_department_label(d) }.join(", ") %>)</span><% end %></li>
      <% end %>
    </ul>
  <% end %>

  <% if opportunities.any? %>
    <div class="card-grid-3" style="margin-top:5mm;">
      <% opportunities.each do |o| %>
        <div class="rec-card">
          <span class="pill"><%= h o["level"].to_s.humanize %></span>
          <h4><%= h o["title"] %></h4>
          <p><%= h o["problem_statement"] %></p>
          <% if o["direction"].present? %><p><strong>Direction:</strong> <%= h o["direction"] %></p><% end %>
          <% if o["capacity"].present? %><p class="muted"><%= h o["capacity"] %></p><% end %>
          <% if o["planned_change"].present? %><p class="muted">Planned change: <%= h o["planned_change"] %></p><% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if views.any? %>
    <h3 style="margin-top:6mm;">Where accounts differ</h3>
    <ul class="plain" style="padding-left:4mm;">
      <% views.each do |v| %>
        <li>
          Management reports: <%= h v["management_reports"] %>.
          <% if v["staff_describe"].present? %>Staff describe: <%= h v["staff_describe"] %>.<% end %>
          <% if v["conclusion"].present? %><%= h v["conclusion"] %><% else %>Accounts differ; this should be validated.<% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
<% end %>
