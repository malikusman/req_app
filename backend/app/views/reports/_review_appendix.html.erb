<% company_name = snapshot.dig("company", "name") %>
<% overall = Array(review_notes).select { |n| n["section_key"].blank? } %>
<% section_notes = Array(review_notes).select { |n| n["section_key"].present? } %>
<% reviewers = overall.map { |n| n["reviewer"] }.uniq %>

<%= render "reports/divider",
      accent_label: "Appendix",
      accent_bg: "var(--blue)",
      eyebrow: "Appendix — included on platform-approved reports only",
      title: "Reviewer notes",
      lead: "Overall notes and section-level comments from expert review, gathered at platform approval. Live discussions and interview follow-up threads are collaboration tooling and are intentionally excluded from this deliverable.",
      highlights: [
        "<strong>#{reviewers.size}</strong> reviewer#{'s' unless reviewers.size == 1} contributed notes.".html_safe,
        "<strong>#{section_notes.size}</strong> section comment#{'s' unless section_notes.size == 1} included.".html_safe
      ] %>

<section class="page">
  <div class="eyebrow">Appendix · Reviewer notes</div>
  <h1 style="font-size:26pt;margin:4mm 0 5mm;">Overall notes</h1>
  <% if overall.any? %>
    <div class="split" style="grid-template-columns:1fr 1fr;">
      <% overall.each do |note| %>
        <div class="reviewer-note">
          <div class="who"><%= h note["reviewer"] %></div>
          <div class="role">Expert reviewer</div>
          <p><%= h note["body"] %></p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="lead">No overall notes were submitted with this review.</p>
  <% end %>

  <% if section_notes.any? %>
    <div class="eyebrow" style="margin-top:9mm;">Section comments</div>
    <div class="review-list">
      <div class="review-row head"><span class="sec">Section</span><span>Reviewer</span><span>Comment</span></div>
      <% section_notes.each do |note| %>
        <div class="review-row">
          <span class="sec"><%= h note["section_key"].to_s.tr("_", " ") %></span>
          <span><%= h note["reviewer"] %></span>
          <span class="cmt"><%= h note["body"] %></span>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
