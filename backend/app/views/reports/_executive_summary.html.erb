<% company_name = snapshot.dig("company", "name") %>
<% participation = snapshot["participation"] || {} %>
<% invited = participation["invited"].to_i %>
<% completed = participation["completed"].to_i %>
<% patterns_count = Array(snapshot["patterns"]).size %>
<% recs_count = Array(snapshot["recommendations"]).size %>
<% docs_first = snapshot["docs_first_phase"] == true || snapshot["report_kind"].to_s == "baseline" %>
<% doc_count = report_evidence_base(snapshot)["documents"].to_i %>
<% situation = snapshot["situation"].is_a?(Hash) ? snapshot["situation"] : {} %>
<% narrative = snapshot["narrative"].is_a?(Hash) ? snapshot["narrative"] : {} %>
<% summary = snapshot["executive_summary"].to_s %>
<% paragraphs = summary.split(/(?<=\.)\s+/).reject(&:blank?) %>
<% paragraphs = [summary] if paragraphs.empty? && summary.present? %>
<% support = Array(narrative["supporting_points"]).reject(&:blank?) %>
<section class="page">
  <div class="eyebrow">Executive summary</div>
  <h1 class="page-title">The story <span class="serif-accent">in one read</span></h1>
  <% if narrative["governing_thought"].present? %>
    <%# Pyramid: answer-first governing thought, then evidence-backed support. %>
    <p class="lead" style="max-width:220mm;margin-bottom:4mm;"><strong><%= h narrative["governing_thought"] %></strong></p>
    <div class="cols-3">
      <%# Drop cap only when the paragraph opens with a letter. Model prose can
          begin with a figure ("3 of 5 employees…"), and a 34pt numeral reads as
          a fault rather than as typography. %>
      <%# The writer's summary can be dropped by the number guard; the computed one
          stands in rather than leaving the column empty. %>
      <% summary_text = narrative["executive_summary"].presence || summary %>
      <p class="<%= summary_text.to_s.lstrip.match?(/\A[[:alpha:]]/) ? "dropcap" : "" %>"><%= h summary_text %></p>
      <% if support.any? %>
        <ul class="plain" style="padding-left:4mm;">
          <% support.first(3).each do |pt| %><li><%= h pt %></li><% end %>
        </ul>
      <% end %>
      <% if narrative["stakes"].present? %>
        <p><strong>What's at stake:</strong> <%= h narrative["stakes"] %></p>
      <% end %>
    </div>
  <% else %>
    <% if situation["headline"].present? %>
      <p class="lead" style="max-width:220mm;margin-bottom:4mm;"><strong><%= h situation["headline"] %>.</strong> <%= h situation["context"] %></p>
    <% end %>
    <div class="cols-3">
      <%# No drop cap. These are three short data sentences, and the first one
          starts with a figure — "3 of 5 employees completed…" — so the drop cap
          rendered a 34pt numeral beside body text in one column of three, which
          reads as a rendering fault rather than as typography. %>
      <% paragraphs.first(3).each do |para| %>
        <p><%= h para %></p>
      <% end %>
    </div>
    <% if Array(situation["focus_areas"]).any? %>
      <p class="method" style="margin-top:5mm;">Focus areas: <%= h Array(situation["focus_areas"]).first(4).join(" · ") %></p>
    <% end %>
    <% if situation["ask"].present? %>
      <p class="method"><%= h situation["ask"] %></p>
    <% end %>
  <% end %>
  <%# The readiness score used to lead this row. It is our gate for generating a
      report, not something a client acts on, so the row now leads with the hours. %>
  <% findings_totals = snapshot.dig("findings", "totals") || {} %>
  <div class="stat-row" style="margin-top:7mm;">
    <% if findings_totals["hours_min"] %>
      <div class="stat"><div class="num"><%= report_hours(findings_totals["hours_min"], findings_totals["hours_max"]) %></div><div class="lab">Hours a year in the work described</div></div>
      <div class="stat"><div class="num"><%= findings_totals["findings"].to_i %></div><div class="lab">Findings across <%= pluralize(findings_totals["roles"].to_i, "role") %></div></div>
    <% end %>
    <% if docs_first %>
      <div class="stat"><div class="num"><%= doc_count %></div><div class="lab">Internal documents analyzed</div></div>
    <% else %>
      <div class="stat"><div class="num"><%= completed %>/<%= invited %></div><div class="lab">Employees completed the interview</div></div>
    <% end %>
    <% unless findings_totals["hours_min"] %>
      <div class="stat"><div class="num"><%= patterns_count %></div><div class="lab">Cross-team patterns identified</div></div>
    <% end %>
    <% if Array(snapshot["priorities"]).any? %>
      <div class="stat"><div class="num"><%= Array(snapshot["priorities"]).size %></div><div class="lab">Priorities to act on first</div></div>
    <% else %>
      <div class="stat"><div class="num"><%= recs_count %></div><div class="lab">Recommendations</div></div>
    <% end %>
  </div>
  <% key_metrics = Array(snapshot["key_metrics"]).first(6) %>
  <% if key_metrics.any? %>
    <div class="metric-band">
      <div class="exlabel" style="margin-bottom:3mm;">By the numbers · from the evidence</div>
      <div class="metric-grid">
        <% key_metrics.each do |m| %>
          <div class="metric-card">
            <div class="metric-headline <%= 'is-negative' if m['direction'] == 'negative' %>"><%= h m["headline"] %></div>
            <% if m["comparison"].present? %><div class="metric-compare"><%= h m["comparison"] %></div><% end %>
            <div class="metric-label"><%= h m["label"] %></div>
            <% if m["source"].present? %><div class="metric-source"><%= h m["source"] %></div><% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
