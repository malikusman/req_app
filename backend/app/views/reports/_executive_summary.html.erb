<% company_name = snapshot.dig("company", "name") %>
<% participation = snapshot["participation"] || {} %>
<% invited = participation["invited"].to_i %>
<% completed = participation["completed"].to_i %>
<% readiness_score = snapshot.dig("readiness", "score").to_f.round %>
<% patterns_count = Array(snapshot["patterns"]).size %>
<% recs_count = Array(snapshot["recommendations"]).size %>
<% docs_first = snapshot["docs_first_phase"] == true || snapshot["report_kind"].to_s == "baseline" %>
<% doc_count = Array(snapshot["supporting_documents"]).size %>
<% summary = snapshot["executive_summary"].to_s %>
<% paragraphs = summary.split(/(?<=\.)\s+/).reject(&:blank?) %>
<% paragraphs = [summary] if paragraphs.empty? && summary.present? %>
<section class="page">
  <div class="eyebrow">01 — Executive summary</div>
  <h1 style="font-size:32pt;margin:4mm 0 6mm;">The story <span class="serif-accent">in one read</span></h1>
  <div class="cols-3">
    <% paragraphs.first(3).each_with_index do |para, i| %>
      <p class="<%= i.zero? ? 'dropcap' : '' %>"><%= h para %></p>
    <% end %>
  </div>
  <div class="stat-row" style="margin-top:10mm;">
    <div class="stat"><div class="num"><%= readiness_score %></div><div class="lab">Readiness score, out of 100</div></div>
    <% if docs_first %>
      <div class="stat"><div class="num cat-data"><%= doc_count %></div><div class="lab">Internal documents analyzed</div></div>
    <% else %>
      <div class="stat"><div class="num cat-data"><%= completed %>/<%= invited %></div><div class="lab">Employees completed the interview</div></div>
    <% end %>
    <div class="stat"><div class="num cat-people"><%= patterns_count %></div><div class="lab">Cross-team patterns identified</div></div>
    <div class="stat"><div class="num"><%= recs_count %></div><div class="lab">Recommendations, catalog-matched</div></div>
  </div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
