<% company_name = snapshot.dig("company", "name") %>
<% readiness = snapshot["readiness"] || {} %>
<% score = readiness["score"].to_f.round %>
<% bars = report_readiness_bars(readiness["breakdown"]) %>
<section class="page">
  <div class="eyebrow">02 — Readiness</div>
  <h1 style="font-size:28pt;margin:4mm 0 3mm;">A readiness score of <span class="serif-accent"><%= score %></span></h1>
  <div class="split">
    <div>
      <p class="lead">Readiness gates report generation. It is a weighted score across employee coverage, department spread, pattern confidence, and multimodal evidence.</p>
      <p><%= h company_name %>’s composite score reflects the depth of discovery completed so far. Gaps in any weighted component are the fastest route to a stronger next version.</p>
    </div>
    <div class="exhibit">
      <div class="exlabel">Exhibit 1 · Readiness breakdown</div>
      <h3>Weighted across employees, departments, patterns, and multimodal evidence.</h3>
      <div class="gauge">
        <%= report_donut_svg(score, "#1F40FF") %>
        <div class="bars" style="flex:1;">
          <% bars.each do |bar| %>
            <div class="bar-row">
              <span><%= h bar[:label] %></span>
              <span class="bar-track"><span class="bar-fill <%= bar[:cat] %>" style="width:<%= bar[:pct] %>%"></span></span>
              <span class="bar-val"><%= bar[:display] %></span>
            </div>
          <% end %>
        </div>
      </div>
      <div class="caption"><%= h report_source_caption(company_name, version: report_version) %></div>
      <div class="mark">Req</div>
    </div>
  </div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
