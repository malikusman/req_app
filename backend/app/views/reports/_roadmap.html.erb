<% company_name = snapshot.dig("company", "name") %>
<% roadmap = snapshot.dig("narrative", "roadmap") %>
<% roadmap = roadmap.is_a?(Hash) ? roadmap : {} %>
<% phases = [["now", "Now", "0–30 days · quick wins"], ["next", "Next", "1–3 months · build on wins"], ["later", "Later", "3–6 months · structural"]] %>
<% has_any = phases.any? { |key, _, _| Array(roadmap[key]).any? } %>
<% if has_any %>
<section class="page">
  <div class="eyebrow">08 — Roadmap</div>
  <h1 style="font-size:28pt;margin:4mm 0 3mm;">A sequenced path, not a wish list</h1>
  <p class="lead" style="max-width:200mm;">Prioritized into quick wins, near-term build, and structural moves — grounded in the findings above.</p>
  <div class="patterns-3" style="margin-top:5mm;">
    <% phases.each_with_index do |(key, label, timeframe), idx| %>
      <% items = Array(roadmap[key]) %>
      <div class="rec-card">
        <div class="match <%= %w[cat-people cat-tooling cat-data][idx] %>"><%= label %></div>
        <div class="meta"><%= timeframe %></div>
        <% if items.any? %>
          <ul class="plain" style="padding-left:4mm;margin-top:2mm;">
            <% items.first(5).each do |item| %>
              <li style="margin-bottom:2mm;">
                <strong><%= h item["title"] %></strong>
                <% if item["rationale"].present? %><br/><span class="muted"><%= h item["rationale"] %></span><% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="muted" style="margin-top:2mm;">No items in this horizon yet.</p>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="caption" style="margin-top:4mm;"><%= h report_source_caption(company_name, version: report_version) %></div>
  <%= render "reports/page_footer", company_name: company_name %>
</section>
<% end %>
