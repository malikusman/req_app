# Copy to /opt/req_app/.env.production on the server (never commit secrets).

APP_HOST=https://req.pebbleintelligentsolutions.com
API_PUBLIC_HOST=https://req.pebbleintelligentsolutions.com

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=
JWT_SECRET=
INTERNAL_API_TOKEN=

# Optional Rails.cache Redis URL (defaults to REDIS_URL with path /1 — HIGH-2)
# REDIS_CACHE_URL=redis://redis:6379/1

# Rails + langgraph agent must share REDIS_URL DB /0 for openai:circuit_open (FEAT-AGENTS).
# Do not point the agent at a different Redis instance/DB than Rails Sidekiq/breaker.
# LANGGRAPH_READ_TIMEOUT=45

POSTGRES_USER=req_app
POSTGRES_PASSWORD=
POSTGRES_DB=req_app_production

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_BUCKET=req-app

OPENAI_API_KEY=

# LangSmith tracing for the discovery agent (BLK-4). Auto-enables when key is set.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=worktruth-agent
# LANGSMITH_TRACING=false

# Stripe billing (required in production if STRIPE_SECRET_KEY is set — BLK-5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Meta WhatsApp (required for live WhatsApp)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WHATSAPP_DISPLAY_NUMBER=
META_TEMPLATE_EMPLOYEE_INVITE=employee_discovery_invite
META_TEMPLATE_EMPLOYEE_NUDGE=employee_discovery_nudge
META_TEMPLATE_REVIEWER_FOLLOWUP=reviewer_followup_reopen

# Email / SMTP (required for signup, invites, password-set mail)
# Zoho org / custom domain → smtppro.zoho.com; personal Zoho → smtp.zoho.com
# Use a Zoho App Password (Accounts → Security → App Passwords), not login password.
# FROM_EMAIL must match the SMTP mailbox. Do not commit real SMTP_PASSWORD.
SMTP_ADDRESS=smtppro.zoho.com
SMTP_PORT=587
SMTP_USERNAME=support@getagentstudio.com
SMTP_PASSWORD=
FROM_EMAIL=support@getagentstudio.com

WEB_CONCURRENCY=1
SIDEKIQ_CONCURRENCY=5
FORCE_SSL=true
